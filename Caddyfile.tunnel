# Caddyfile.tunnel — режим Cloudflare Tunnel (компьютер за NAT, без белого IP)
#
# Отличие от обычного Caddyfile: сертификатом и HTTPS занимается Cloudflare,
# сюда запрос приходит уже расшифрованным, по внутренней сети docker. Поэтому
# здесь простой :80 без домена и без ACME — наружу этот порт не публикуется.
#
# Зачем прослойка, если cloudflared умеет ходить прямо в bot:3000: чтобы
# правило «наружу открыт только /r/*» жило в репозитории, а не в настройках
# облачной панели. Опечатка в панели не должна открывать /metrics всему миру.

:80 {
	# Единственный публичный маршрут — редирект по рекламной ссылке.
	handle /r/* {
		reverse_proxy bot:3000
	}

	# Всё остальное закрыто: /health и /metrics показывают состояние очередей
	# и потребление памяти — этому в открытом интернете не место.
	handle {
		respond "Not found" 404
	}

	encode gzip

	# Логи в stdout: смотреть через docker compose logs edge
	log
}
