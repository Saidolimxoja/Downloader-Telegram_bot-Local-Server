# Caddyfile — HTTPS для отслеживания переходов по рекламе
#
# Caddy сам получает сертификат Let's Encrypt и продлевает его — ничего
# настраивать вручную не нужно. Требуется лишь, чтобы домен указывал на этот
# сервер, а порты 80 и 443 были открыты (80 нужен для проверки владения).

{$DOMAIN} {
	# Наружу открыт РОВНО ОДИН маршрут — редирект по рекламной ссылке.
	handle /r/* {
		reverse_proxy bot:3000
	}

	# Всё остальное закрыто. /health и /metrics показывают состояние очередей
	# и потребление памяти — этому в открытом интернете не место.
	handle {
		respond "Not found" 404
	}

	encode gzip

	log {
		output file /var/log/caddy/access.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}
