# === БОТ ===
BOT_TOKEN=your_bot_token_from_botfather
YOUR_USERNAME=@your_bot_username
API_URL=http://localhost:8081

# Роль процесса: bot | worker | all
#   bot    — принимает сообщения, ставит задачи в очередь (ровно 1 экземпляр)
#   worker — разбирает очередь: качает, перекодирует, заливает (масштабируется)
#   all    — всё в одном процессе, удобно для локальной разработки
ROLE=all

# === TELEGRAM API (для локального Bot API server) ===
API_ID=your_api_id_from_my_telegram_org
API_HASH=your_api_hash_from_my_telegram_org

# === КАНАЛЫ ===
CHANNEL_ID=your_channel_id_for_archive

# === ДОМЕН И ОТСЛЕЖИВАНИЕ ПЕРЕХОДОВ ПО РЕКЛАМЕ ===
# Кнопка объявления ведёт через ваш домен, чтобы засчитать переход:
#   PUBLIC_URL/r/<adId>/<userId>/<подпись> → 302 на сайт рекламодателя
# Без PUBLIC_URL отслеживание отключается, кнопки ведут напрямую,
# а CTR в статистике остаётся нулевым.
PUBLIC_URL=https://example.com
# Тот же домен без схемы — нужен Caddy для выпуска сертификата
DOMAIN=example.com

# === CLOUDFLARE TUNNEL (если нет белого IP) ===
# Нужен только при запуске с профилем tunnel:
#   docker compose --profile tunnel up -d
# Токен берётся в панели Cloudflare Zero Trust при создании туннеля.
# При работе через туннель DOMAIN не используется — сертификат выпускает
# Cloudflare, а не Caddy. PUBLIC_URL по-прежнему обязателен.
TUNNEL_TOKEN=

# === БАЗА ДАННЫХ ===
# connection_limit важен: у бота и КАЖДОГО воркера свой пул соединений.
# Без него Prisma берёт cpus*2+1 на процесс и при нескольких репликах
# упирается в max_connections Postgres.
DATABASE_URL=postgresql://user:password@host:5432/database?connection_limit=10&pool_timeout=20
DIRECT_URL=postgresql://user:password@host:5432/database

# === REDIS ===
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# === ПРИЛОЖЕНИЕ ===
NODE_ENV=development
PORT=3000
# error | warn | log | debug. По умолчанию: в проде log, в разработке debug
LOG_LEVEL=log

# === ПУТИ ===
YTDLP_PATH=yt-dlp
DOWNLOADS_DIR=./downloads
COOKIES_PATH=./youtube_cookies.txt

# === ОЧЕРЕДИ И ПАРАЛЛЕЛИЗМ ===
# Одновременных загрузок на ОДИН воркер (ffmpeg жрёт ядро целиком)
MAX_PARALLEL_DOWNLOADS=3
# Одновременных разборов ссылок на воркер. Каждый — процесс yt-dlp
# на 60-120 МБ, поэтому потолок держим осознанно
MAX_PARALLEL_ANALYSIS=5
# Сколько задач может ждать в очередях, прежде чем бот начнёт честно
# отвечать «сейчас перегружен»
MAX_QUEUE_SIZE=500
# Сколько апдейтов Telegram обрабатывается параллельно
UPDATE_CONCURRENCY=50

# === ЛИМИТЫ НА ПОЛЬЗОВАТЕЛЯ ===
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_HOUR=60
MAX_ACTIVE_ANALYSIS_PER_USER=2

# === ТАЙМАУТЫ YT-DLP (мс) ===
YTDLP_ANALYZE_TIMEOUT_MS=30000
YTDLP_DOWNLOAD_TIMEOUT_MS=600000

# === УБОРКА ДИСКА ===
# Файлы старше этого возраста считаются забытыми и удаляются по крону
ORPHAN_FILE_MAX_AGE_MINUTES=120
